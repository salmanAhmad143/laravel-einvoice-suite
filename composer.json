{
    "name": "salmanahmad143/laravel-einvoice-suite",
    "description": "Multi-provider E-Invoice integration for Laravel 8+ (EY, Adaequare, etc.)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Salman Ahmad",
            "email": "naved.nice@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "LaravelEInvoiceSuite\\": "src/"
        }
    },
    "extra": {
